# -------------------------------------------------------
# Copy this file to .env and fill in your real values:
#     cp .env.example .env
# -------------------------------------------------------

# Root directory for all docker service data/config.
DOCKER_ROOT=/home/<user>/docker

# Host drive's paths.
STORAGE_MOUNT=
BACKUP_MOUNT=

# Timezone, e.g. UTC, Europe/Paris, Asia/Ho_Chi_Minh.
TIMEZONE=

# ---------------------------------------------------------------------------
# Host ports, named <APP>_PORT_<PURPOSE>
# (external host port only; container port is fixed in each compose file)
# ---------------------------------------------------------------------------
PORTAINER_PORT_HTTP=8000
PORTAINER_PORT_HTTPS=9443
HOMEPAGE_PORT_WEB=3000
ADGUARD_PORT_DNS=53
ADGUARD_PORT_SETUP=3001
ADGUARD_PORT_WEB=8080
VAULTWARDEN_PORT_WEB=8081
FILEBROWSER_PORT_WEB=8082

# ---------------------------------------------------------------------------
# Secrets / API keys
# ---------------------------------------------------------------------------
# Vaultwarden admin token. Generate with: openssl rand -base64 32
VAULTWARDEN_ADMIN_TOKEN=changeme

# Cloudflare Tunnel token (from the Cloudflare Zero Trust dashboard).
CLOUDFLARED_TOKEN=changeme

# Speedtest Tracker Laravel APP_KEY (base64 value only, no "base64:" prefix).
SPEEDTEST_KEY=changeme

# Homepage widget secrets. Any widget option named `key` is passed as
# HOMEPAGE_VAR_<WIDGET>_KEY. Add your own below.
# HOMEPAGE_VAR_PROXMOX_USER=homepage
# HOMEPAGE_VAR_PROXMOX_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# HOMEPAGE_VAR_PORTAINER_KEY=ptr_xxxxxxxxxxxxxxxxxxxxxxxx
