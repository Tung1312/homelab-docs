# -------------------------------------------------------
# Copy this file to .env and fill in your real values:
#     cp .env.example .env
# -------------------------------------------------------

# Root directory for all docker service data/config.
DOCKER_ROOT=/home/<user>/docker

# Host drive's paths.
STORAGE_MOUNT=
BACKUP_MOUNT=

# Timezone, e.g. UTC, Europe/Paris, Asia/Ho_Chi_Minh.
TIMEZONE=

# -------------------------------------------------------
# Host ports (external host port only; container port is fixed in each compose file)
# -------------------------------------------------------

PORTAINER_PORT_HTTP=
PORTAINER_PORT_HTTPS=

HOMEPAGE_PORT_WEB=
HOMEPAGE_ALLOWED_HOSTS=

ADGUARD_PORT_DNS=
ADGUARD_PORT_SETUP=
ADGUARD_PORT_WEB=

VAULTWARDEN_PORT_WEB=

FILEBROWSER_PORT_WEB=

NGINX_PORT_HTTP=
NGINX_PORT_HTTPS=
NGINX_PORT_ADMIN=

# -------------------------------------------------------
# Secrets / API keys
# -------------------------------------------------------

# Vaultwarden admin token.
VAULTWARDEN_ADMIN_TOKEN=

# Cloudflare Tunnel token.
CLOUDFLARED_TOKEN=

# Speedtest Tracker Laravel APP_KEY.
SPEEDTEST_KEY=

# Homepage widget variables. Reference these in the config files under
# docker/homepage/config/ using {{HOMEPAGE_VAR_...}}.

# Speedtest
HOMEPAGE_VAR_SPEEDTEST_URL=

# Cloudflared
HOMEPAGE_VAR_CLOUDFLARED_ACCOUNT_ID=
HOMEPAGE_VAR_CLOUDFLARED_TUNNEL_ID=
HOMEPAGE_VAR_CLOUDFLARED_KEY=

# Nginx Proxy Manager
HOMEPAGE_VAR_NPM_URL=
HOMEPAGE_VAR_NPM_USERNAME=
HOMEPAGE_VAR_NPM_PASSWORD=

# AdGuard Home
HOMEPAGE_VAR_ADGUARD_URL=
HOMEPAGE_VAR_ADGUARD_USERNAME=
HOMEPAGE_VAR_ADGUARD_PASSWORD=

# Portainer
HOMEPAGE_VAR_PORTAINER_URL=
HOMEPAGE_VAR_PORTAINER_KEY=

# Jellyfin
HOMEPAGE_VAR_JELLYFIN_URL=
HOMEPAGE_VAR_JELLYFIN_KEY=

# Nextcloud
HOMEPAGE_VAR_NEXTCLOUD_URL=
HOMEPAGE_VAR_NEXTCLOUD_USERNAME=
HOMEPAGE_VAR_NEXTCLOUD_PASSWORD=

# Immich
HOMEPAGE_VAR_IMMICH_URL=
HOMEPAGE_VAR_IMMICH_KEY=

# qBittorrent
HOMEPAGE_VAR_QBITTORRENT_URL=
HOMEPAGE_VAR_QBITTORRENT_USERNAME=
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=

# Sonarr
HOMEPAGE_VAR_SONARR_URL=
HOMEPAGE_VAR_SONARR_KEY=

# Radarr
HOMEPAGE_VAR_RADARR_URL=
HOMEPAGE_VAR_RADARR_KEY=

# Weather
HOMEPAGE_VAR_LATITUDE=
HOMEPAGE_VAR_LONGITUDE=
